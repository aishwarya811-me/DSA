class Solution {
public:
    int reverseNum(int n) {
        int revsnum = 0;

        while (n != 0) {
            int digit = n % 10;

            if (revsnum > INT_MAX / 10 || revsnum < INT_MIN / 10) {
                return 0;
            }

            revsnum = revsnum * 10 + digit;
            n /= 10;
        }

        return revsnum;
    }

    bool isPalindrome(int n) {
        if (n < 0) return false;

        int original = n;
        int reversed = reverseNum(n);

        return original == reversed;
    }
};
