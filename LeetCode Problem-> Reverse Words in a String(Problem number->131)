class Solution {
public:
    string reverseWords(string s) {
        int n = s.length();
        string ans = "";

        reverse(s.begin(), s.end());

        for (int i = 0; i < n; i++) {
            string word = "";

            // Skip spaces
            while (i < n && s[i] == ' ')
                i++;

            // Collect a word
            while (i < n && s[i] != ' ') {
                word += s[i];
                i++;
            }

            // Reverse the word back
            reverse(word.begin(), word.end());

            if (word.length() > 0) {
                if (!ans.empty())
                    ans += " ";
                ans += word;
            }
        }

        return ans;
    }
};
