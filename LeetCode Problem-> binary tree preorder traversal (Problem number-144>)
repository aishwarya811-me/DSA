
class Solution {
public:
      vector<int> result;
    vector<int> preorderTraversal(TreeNode* root) {


        fun(root);
        return result;

    }
    void fun(TreeNode* root)
    {
        if(root==NULL)
        return;
        result.push_back(root->val);
        fun(root -> left);
         fun(root -> right);
    }
};
