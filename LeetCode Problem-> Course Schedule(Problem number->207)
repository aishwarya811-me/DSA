class Solution {
public:

    bool dfs(int s, vector<int>& visited, vector<int>& path,
             vector<vector<int>>& adj) {

        visited[s] = 1;
        path[s] = 1;

        for (int i = 0; i < adj[s].size(); i++) {

            int x = adj[s][i];

            if (visited[x] == 0) {

                if (dfs(x, visited, path, adj)) {
                    return true;
                }
            }

            else if (path[x] == 1) {
                return true;
            }
        }

        path[s] = 0;

        return false;
    }
